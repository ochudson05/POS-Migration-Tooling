# Settings for the Oracle server. setup.sh copies this to .env (which git ignores). Never commit .env.

# The gateway key. setup.sh makes a random one. Put the same value in Cloudflare as the Worker secret ORACLE_KEY.
MH_KEY=

# Cloudflare Tunnel token: Zero Trust > Networks > Tunnels > your tunnel > the long value after "--token" in its
# install command. setup.sh asks for it.
TUNNEL_TOKEN=

# The small local model for the website's "small jobs" (Ollama library name). If you change it, also set the Worker
# variable LOCAL_MODEL in Cloudflare to the same name.
LOCAL_MODEL=qwen3:4b

# Optional: the scraper's last-resort loader for heavily protected sites (uses Firecrawl credits).
FIRECRAWL_API_KEY=

# Nightly database backups (backup.sh). A Cloudflare API token with "Account > D1 > Edit" for your account,
# and the account ID (Cloudflare dashboard > Workers & Pages, right-hand side).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional: an Oracle Object Storage pre-authenticated request URL (bucket, "Permit object writes"), so each backup
# is also kept off this server. Ends in /o/
BACKUP_PAR_URL=
# How many days of backups to keep on this server.
KEEP_DAYS=30
