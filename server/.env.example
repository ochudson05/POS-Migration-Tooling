# Settings for the Menu Hauler server. setup.sh copies this to .env (which git ignores). Never commit .env.

# The gateway key. setup.sh makes a random one. Put the same value in Cloudflare as the Worker secret SERVER_KEY.
MH_KEY=

# Cloudflare Tunnel token: Zero Trust > Networks > Tunnels > your tunnel > the long value after "--token" in its
# install command. setup.sh asks for it.
TUNNEL_TOKEN=

# Memory for the scraper and its browser. 1400m suits a 2 GB VM (e2-small); 3g or more on a 4 GB+ VM.
SCRAPER_MEM=1400m

# The small local model (Ollama) is off: it needs a VM with 8 GB or more. To turn it on, set
# COMPOSE_PROFILES=local-model, run setup.sh again, and set the Worker variable LOCAL_MODEL_ON to 1.
COMPOSE_PROFILES=
# The local model's name in the Ollama library. If you change it, also set the Worker variable LOCAL_MODEL to it.
LOCAL_MODEL=qwen3:4b
OLLAMA_MEM=6g

# Optional: the scraper's last-resort loader for heavily protected sites (uses Firecrawl credits).
FIRECRAWL_API_KEY=

# Nightly database backups (backup.sh). A Cloudflare API token with "Account > D1 > Edit" for your account,
# and the account ID (Cloudflare dashboard > Workers & Pages, right-hand side).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional, so each backup is also kept off this server (either or both):
#   a Google Cloud Storage folder, written with the VM's own service account, e.g. gs://menuhauler-backups/d1
BACKUP_GCS_BUCKET=
#   any address that takes an HTTP PUT per file (the file name is added to the end)
BACKUP_PUT_URL=
# How many days of backups to keep on this server.
KEEP_DAYS=30
