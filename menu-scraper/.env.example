# Copy to .env and fill in what you have. Everything is optional.

# Require callers to send this key (header X-API-Key or "Authorization: Bearer ...").
# Leave blank for local use only.
API_KEY=

# Claude reads menus that have no machine-readable data (most sites, PDFs, menu photos).
# Without it the service returns the page as markdown and the converter parses it itself.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Fallback for sites the built-in fetchers can't load (heavy bot protection).
FIRECRAWL_API_KEY=

# Optional outbound proxy for the HTTP and browser tiers, e.g. http://user:pass@host:port
PROXY_URL=

# Browser origins allowed to call the API (comma separated). * = any.
ALLOWED_ORIGINS=*

# Set to 0 to skip the headless browser tier (e.g. on a tiny server).
ENABLE_BROWSER=1

PORT=8787
